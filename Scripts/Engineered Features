-- credit_usd

CREATE TABLE credit_usd AS
SELECT
    id,
    limit_bal * 0.032 AS limit_bal_usd,
    sex,
    education,
    marriage,
    age,
    pay_0,
    pay_2,
    pay_3,
    pay_4,
    pay_5,
    pay_6,
    bill_amt1 * 0.032 AS bill_amt1_usd,
    bill_amt2 * 0.032 AS bill_amt2_usd,
    bill_amt3 * 0.032 AS bill_amt3_usd,
    bill_amt4 * 0.032 AS bill_amt4_usd,
    bill_amt5 * 0.032 AS bill_amt5_usd,
    bill_amt6 * 0.032 AS bill_amt6_usd,
    pay_amt1 * 0.032 AS pay_amt1_usd,
    pay_amt2 * 0.032 AS pay_amt2_usd,
    pay_amt3 * 0.032 AS pay_amt3_usd,
    pay_amt4 * 0.032 AS pay_amt4_usd,
    pay_amt5 * 0.032 AS pay_amt5_usd,
    pay_amt6 * 0.032 AS pay_amt6_usd,
    default_flag
FROM credit_staging;

SELECT * FROM credit_usd
limit 10;
-----------------------------------

-----------------------------------


-- credit_features 

CREATE TABLE credit_features AS
SELECT
    id,
    limit_bal_usd,
    sex,
    education,
    marriage,
    age,
    default_flag,

    (bill_amt1_usd + bill_amt2_usd + bill_amt3_usd + bill_amt4_usd + bill_amt5_usd + bill_amt6_usd)
        AS total_bill_amt_usd,

    (pay_amt1_usd + pay_amt2_usd + pay_amt3_usd + pay_amt4_usd + pay_amt5_usd + pay_amt6_usd)
        AS total_pay_amt_usd,

    ((bill_amt1_usd + bill_amt2_usd + bill_amt3_usd + bill_amt4_usd + bill_amt5_usd + bill_amt6_usd) / 6.0)
        AS avg_monthly_bill_usd,

    ((pay_amt1_usd + pay_amt2_usd + pay_amt3_usd + pay_amt4_usd + pay_amt5_usd + pay_amt6_usd) / 6.0)
        AS avg_monthly_pay_usd,

    GREATEST(pay_0, pay_2, pay_3, pay_4, pay_5, pay_6)
        AS worst_pay_status,

    CASE
        WHEN GREATEST(pay_0, pay_2, pay_3, pay_4, pay_5, pay_6) >= 1 THEN 1
        ELSE 0
    END AS any_delinquency_flag

FROM credit_usd;


SELECT * FROM credit_features
limit 10;

SELECT
    MIN(late_months_count),
    MAX(late_months_count)
FROM credit_features;

SELECT COUNT(*)
FROM credit_features
WHERE payment_coverage_ratio IS NULL

SELECT
    id,
    total_bill_amt_usd,
    total_pay_amt_usd
FROM credit_features
WHERE payment_coverage_ratio IS NULL
LIMIT 20;

SELECT column_name, data_type, numeric_precision, numeric_scale
FROM information_schema.columns
WHERE table_name = 'credit_features';

-----------------------------------

-----------------------------------

ALTER TABLE credit_features
ADD COLUMN avg_monthly_balance_usd NUMERIC,
ADD COLUMN avg_pay_amt_usd NUMERIC,
ADD COLUMN util_proxy_usd NUMERIC,
ADD COLUMN payment_coverage_ratio NUMERIC,
ADD COLUMN late_months_count INTEGER;


-----------------------------------

-----------------------------------

UPDATE credit_features
SET
  avg_monthly_balance_usd = total_bill_amt_usd / 6,
  avg_pay_amt_usd = total_pay_amt_usd / 6,
  util_proxy_usd = (total_bill_amt_usd / 6) / NULLIF(limit_bal_usd, 0),
  payment_coverage_ratio = NULLIF(total_pay_amt_usd, 0) / NULLIF(total_bill_amt_usd, 0);

-----------------------------------
UPDATE credit_features cf
SET late_months_count =
    (CASE WHEN s.pay_0 > 0 THEN 1 ELSE 0 END +
     CASE WHEN s.pay_2 > 0 THEN 1 ELSE 0 END +
     CASE WHEN s.pay_3 > 0 THEN 1 ELSE 0 END +
     CASE WHEN s.pay_4 > 0 THEN 1 ELSE 0 END +
     CASE WHEN s.pay_5 > 0 THEN 1 ELSE 0 END +
     CASE WHEN s.pay_6 > 0 THEN 1 ELSE 0 END)
FROM credit_staging s
WHERE cf.id = s.id;

-----------------------------------
ALTER TABLE credit_features
ALTER COLUMN limit_bal_usd TYPE NUMERIC(12,2)
USING ROUND(limit_bal_usd, 2),

ALTER COLUMN avg_monthly_balance_usd TYPE NUMERIC(14,2)
USING ROUND(avg_monthly_balance_usd, 2),

ALTER COLUMN avg_pay_amt_usd TYPE NUMERIC(14,2)
USING ROUND(avg_pay_amt_usd, 2),

ALTER COLUMN util_proxy_usd TYPE NUMERIC(14,2)
USING ROUND(util_proxy_usd, 2);


-----------------------------------

-----------------------------------

CREATE TABLE credit_features AS
SELECT
    id,
    limit_bal_usd,
    sex,
    education,
    marriage,
    age,
    default_flag,

    (bill_amt1_usd + bill_amt2_usd + bill_amt3_usd + bill_amt4_usd + bill_amt5_usd + bill_amt6_usd)
        AS total_bill_amt_usd,

    (pay_amt1_usd + pay_amt2_usd + pay_amt3_usd + pay_amt4_usd + pay_amt5_usd + pay_amt6_usd)
        AS total_pay_amt_usd,

    ((bill_amt1_usd + bill_amt2_usd + bill_amt3_usd + bill_amt4_usd + bill_amt5_usd + bill_amt6_usd) / 6.0)
        AS avg_monthly_bill_usd,

    ((pay_amt1_usd + pay_amt2_usd + pay_amt3_usd + pay_amt4_usd + pay_amt5_usd + pay_amt6_usd) / 6.0)
        AS avg_monthly_pay_usd,

    GREATEST(pay_0, pay_2, pay_3, pay_4, pay_5, pay_6)
        AS worst_pay_status,

    CASE
        WHEN GREATEST(pay_0, pay_2, pay_3, pay_4, pay_5, pay_6) >= 1 THEN 1
        ELSE 0
    END AS any_delinquency_flag

FROM credit_usd;

-----------------------------------

-----------------------------------
-- credit_features_with_risk

CREATE TABLE credit_features_with_risk AS
SELECT
    *,
    COALESCE(late_months_count, 0)
    + COALESCE(worst_pay_status, 0)
    + COALESCE(utilization_rate, 0)
    - COALESCE(payment_coverage_ratio, 0)
    AS risk_score
FROM credit_features;
